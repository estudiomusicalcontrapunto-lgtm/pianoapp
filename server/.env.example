PORT=5000

# Clave que firma las sesiones. OBLIGATORIA: sin ella (o con un valor de ejemplo o corto) el servidor no arranca.
# Genera una propia, distinta en cada servidor, con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuenta inicial de la academia. Se crea al arrancar solo si ese email no existe.
# Después de entrar la primera vez, puedes borrar ADMIN_PASSWORD de aquí.
ADMIN_EMAIL=admin@academia.com
ADMIN_PASSWORD=

# Producción en Hostinger con MySQL: completa estas variables.
# Si DB_HOST está vacío o comentado, la app usa SQLite local (server/database.sqlite).
# DB_HOST=localhost
# DB_USER=tu_usuario
# DB_PASSWORD=tu_contraseña
# DB_NAME=tu_base_de_datos

# Tareas automáticas (cobro del día 1, plazos de pago, clases dadas por tomadas, cupos vencidos):
# cada cuántos minutos corren. 0 desactiva el temporizador (siguen corriendo al iniciar y al iniciar sesión).
MAINTENANCE_INTERVAL_MINUTES=10

# Carpeta de los comprobantes de pago (por defecto server/uploads). Nunca debe quedar en una carpeta pública.
# UPLOADS_DIR=/ruta/privada/uploads

# DB_STORAGE permite usar otro archivo SQLite (por ejemplo para el seed):
# DB_STORAGE=./seed.sqlite
